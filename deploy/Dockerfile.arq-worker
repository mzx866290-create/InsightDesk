# syntax=docker/dockerfile:1.7

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TASK_BACKEND=arq

WORKDIR /app

RUN pip install --upgrade pip \
    && pip install "arq>=0.26.0"

COPY backend ./backend
COPY deploy ./deploy

CMD ["arq", "backend.tasks.worker.WorkerSettings"]
