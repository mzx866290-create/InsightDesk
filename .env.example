# ============================================
# 模型提供方配置
# ============================================
# 可选值: ollama 或 openrouter
LLM_PROVIDER=ollama

# ============================================
# OpenRouter 配置 (仅 openrouter 模式需要)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
# 推荐模型: qwen/qwen-2.5-72b-instruct, anthropic/claude-sonnet-4.5, deepseek/deepseek-chat
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ============================================
# Ollama 配置 (仅 ollama 模式需要)
# ============================================
# 确保已运行: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen3.5-2B:latest
OLLAMA_BASE_URL=http://localhost:11434
# Optional: override the Ollama URL used inside docker-compose.
# DOCKER_OLLAMA_BASE_URL=http://ollama:11434

# ============================================
# 联网搜索配置
# ============================================
# 获取 API Key: https://tavily.com/
TAVILY_API_KEY=
# Recommended: use Tavily as the default non-Docker web search provider.
# Optional: only set this when you explicitly start a local SearXNG instance.
# Local backend example: SEARXNG_URL=http://localhost:8080
SEARXNG_URL=
# Optional: override the SearXNG URL used inside docker-compose when the
# `search` profile is enabled.
# DOCKER_SEARXNG_URL=http://searxng:8080
# Optional: publish a different host port for the bundled SearXNG service.
# SEARXNG_PORT=8080

# ============================================
# Docker Compose 部署配置
# ============================================
# Host ports published by docker-compose.
APP_PORT=8000
# REDIS_PORT=6379
# QDRANT_PORT=6333
# POSTGRES_PORT=5432
# OLLAMA_PORT=11434
#
# In-container service URLs used by docker-compose. Keep these on service
# hostnames unless you intentionally point Compose at external infrastructure.
# DOCKER_REDIS_URL=redis://redis:6379/0
# DOCKER_QDRANT_URL=http://qdrant:6333
# DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/insightdesk

# ============================================
# Built-in tools
# ============================================
# Optional: control enabled tool order with a comma-separated list.
# Example: ENABLED_BUILTIN_TOOLS=query_knowledge,web_search,quick_answer
# ENABLED_BUILTIN_TOOLS=
#
# Optional: load the same setting from a JSON file instead.
# Supported shapes:
#   1. {"enabled_builtin_tools": ["query_knowledge", "web_search"]}
#   2. ["query_knowledge", "web_search"]
# BUILTIN_TOOL_CONFIG_PATH=./config/builtin_tools.json
#
# Optional: enable MCP-backed implementations for the built-in tool names.
# When enabled without a config file, the app will try to start the local
# `mcp_servers/knowledge_server.py` and `mcp_servers/search_server.py`.
# ENABLE_MCP_TOOLS=false
# ENABLED_MCP_SERVERS=knowledge-base,web-search
#
# Optional: connector policy guardrails for MCP runtime selection.
# Scopes support exact values such as `web:search` and namespace wildcards such as `web:*`.
# Custom/high-risk connectors must be approved before they are selected at runtime.
# MCP_ALLOWED_SCOPES=knowledge:*,web:*
# MCP_APPROVED_CONNECTORS=knowledge-base,web-search
# Runtime approvals can also be managed via GET/POST/DELETE
# /api/connectors/mcp/approvals and are persisted in the app config store.
# MCP_ALLOW_HIGH_RISK=false
# MCP_RUNTIME_PING_TIMEOUT_SECONDS=5
#
# Optional: load MCP server connections from a JSON file.
# The file should match `langchain-mcp-adapters` connection config format.
# MCP_SERVER_CONFIG_PATH=./config/mcp_servers.json
#
# Optional: set a stable secret for signed share links.
# SHARE_LINK_SECRET=change-me

# ============================================
# Identity / SSO
# ============================================
# Token auth remains the active guard. OIDC settings currently expose readiness
# and claim mapping metadata for the SSO productization path.
# SSO_PROVIDER=none
# OIDC_ISSUER_URL=https://idp.example.com
# OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.com/oauth2/v1/authorize
# OIDC_TOKEN_ENDPOINT=https://idp.example.com/oauth2/v1/token
# OIDC_JWKS_URL=https://idp.example.com/oauth2/v1/keys
# OIDC_CLIENT_ID=insightdesk
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# OIDC_ALLOWED_DOMAINS=example.com,ops.example.com
# SSO_DEFAULT_ROLE=viewer
# SSO_SESSION_TTL_SECONDS=28800

# ============================================
# 异步任务队列
# ============================================
# 可选值: memory 或 arq。memory 适合本地开发；arq 需要 Redis 和 worker。
TASK_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0
# DOCKER_REDIS_URL=redis://redis:6379/0
# ARQ_QUEUE_NAME=insightdesk:tasks
# ARQ_WORKER_MAX_JOBS=4
# ARQ_KEEP_RESULT_SECONDS=3600
# Worker processes should preserve pending/running tasks created by the API.
# Keep this true/default for API-only local development; set false for ARQ workers.
# TASK_STORE_FAIL_INCOMPLETE_ON_START=false
# Shared upload staging directory for API and ARQ workers.
DOCUMENT_UPLOAD_STAGING_DIR=/app/runtime/upload_staging

# ============================================
# Embedding 模型配置
# ============================================
# 默认使用 HuggingFace 的中文 embedding 模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# ============================================
# 向量数据库配置
# ============================================
DATABASE_PROVIDER=sqlite
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightdesk
# DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/insightdesk
VECTOR_STORE_PROVIDER=faiss
VECTOR_STORE_PATH=./vector_store
# QDRANT_URL=http://localhost:6333
# DOCKER_QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=insightdesk_kb

# ============================================
# LangSmith 追踪 (可选)
# ============================================
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=enterprise-kb
